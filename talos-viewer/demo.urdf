<?xml version="1.0"?>
<!-- Primitive-only demo arm for talos-viewer. -->
<robot name="demo_arm">
  <material name="grey"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.1 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.2" length="0.1"/></geometry><material name="grey"/></visual>
  </link>
  <link name="turret">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.2 0.2 0.3"/></geometry><material name="orange"/></visual>
  </link>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.25"/><geometry><box size="0.08 0.08 0.5"/></geometry><material name="blue"/></visual>
  </link>
  <link name="forearm">
    <visual><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.035" length="0.4"/></geometry><material name="orange"/></visual>
  </link>
  <link name="tool">
    <visual><geometry><sphere radius="0.06"/></geometry><material name="grey"/></visual>
  </link>
  <link name="finger_left">
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.02 0.02 0.08"/></geometry><material name="blue"/></visual>
  </link>
  <link name="finger_right">
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.02 0.02 0.08"/></geometry><material name="blue"/></visual>
  </link>

  <joint name="base_yaw" type="continuous">
    <parent link="base_link"/><child link="turret"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turret"/><child link="upper_arm"/>
    <origin xyz="0 0 0.3"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.5"/><axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="1"/>
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="forearm"/><child link="tool"/>
    <origin xyz="0 0 0.43"/>
  </joint>
  <joint name="gripper" type="prismatic">
    <parent link="tool"/><child link="finger_left"/>
    <origin xyz="0 0.01 0.04"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="0.1"/>
  </joint>
  <joint name="gripper_mimic" type="prismatic">
    <parent link="tool"/><child link="finger_right"/>
    <origin xyz="0 -0.01 0.04"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="0.1"/>
    <mimic joint="gripper"/>
  </joint>
</robot>
